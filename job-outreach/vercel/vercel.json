{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/cron/tick", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "https://jobhunt-outreach.onrender.com/" },
    { "source": "/:path*", "destination": "https://jobhunt-outreach.onrender.com/:path*" }
  ]
}
