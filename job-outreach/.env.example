# Copy to .env and fill in. Never commit the real file.

# --- Lead sources: Apify (https://console.apify.com/account/integrations) ---
APIFY_TOKEN=
# Actors used (override if you prefer different ones with the same output):
APIFY_LINKEDIN_JOBS_ACTOR=curious_coder~linkedin-jobs-scraper
APIFY_GOOGLE_ACTOR=apify~google-search-scraper

# --- Finding emails (at least one) ---
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- LLM (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Gemini...) ---
# Used for resume import and per-lead tailoring. Without it a deterministic
# engine is used for tailoring and resume import is disabled.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Sending: SMTP for a DEDICATED outreach domain (not your main address's domain) ---
SMTP_HOST=smtp.example-outreach.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SENDER_NAME=Alex Rivera
SENDER_EMAIL=alex@alexrivera-careers.com
# DKIM selector your provider publishes at <selector>._domainkey.<domain>
DKIM_SELECTOR=google
# Optional postal address in the footer
SENDER_POSTAL_ADDRESS=

# --- Reply/bounce detection (IMAP). Login defaults to the SMTP credentials. ---
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Public endpoints ---
PUBLIC_BASE_URL=https://jobhunt.example.com
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
# Protects /cron/tick (the auto emailer trigger)
CRON_SECRET=change-me-too
# Protects the dashboard (HTTP Basic auth, any username)
DASHBOARD_PASSWORD=

# --- Storage: Postgres when hosted (data survives redeploys), SQLite locally ---
DATABASE_URL=
JOBHUNT_DB=data/jobhunt.db
