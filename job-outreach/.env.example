# Copy to .env and fill in. Never commit the real file.
# On Render, set the same names under the service's Environment tab.

# --- Lead sources: Apify (https://console.apify.com/account/integrations) ---
APIFY_TOKEN=
# Actors used (override if you prefer different ones with the same output):
APIFY_LINKEDIN_JOBS_ACTOR=curious_coder~linkedin-jobs-scraper
APIFY_GOOGLE_ACTOR=apify~google-search-scraper

# --- Finding emails (at least one) ---
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- LLM: Google Gemini, free tier (https://aistudio.google.com/apikey) ---
# Used for resume import and per-lead tailoring. Without a key, tailoring uses a
# built-in deterministic engine and resume import is disabled.
GEMINI_API_KEY=
# Defaults, only change if you need to:
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# Free-tier guard rails. Google shows your project's real limits in AI Studio
# (they're per project, and the daily count resets at midnight Pacific).
# LLM_RPM=10                  # requests per minute, spaced evenly
# LLM_RPD=200                 # requests per day; tailoring pauses until tomorrow when reached
# LLM_REASONING_EFFORT=low    # keeps Gemini's "thinking" tokens small
# LLM_MAX_OUTPUT_TOKENS=0     # 0 = no cap
#
# Any other OpenAI-compatible provider works too: set LLM_API_KEY, LLM_BASE_URL
# and LLM_MODEL (or just OPENAI_API_KEY to use OpenAI's gpt-4o-mini).

# --- Sending: SMTP ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (spaces are fine).
# No OAuth, no credentials.json, nothing to refresh.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SENDER_NAME=Your Name
# Defaults for Gmail; change for any other SMTP server (587 = STARTTLS, 465 = SSL):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL defaults to SMTP_USER. For a custom domain also set DKIM_SELECTOR
# (Google Workspace uses "google") so SPF/DKIM/DMARC can be verified.
# SENDER_EMAIL=
# DKIM_SELECTOR=
# Optional postal address in the footer
SENDER_POSTAL_ADDRESS=

# --- Reply/bounce detection (IMAP) ---
# Automatic for Gmail (imap.gmail.com with the same App Password).
# For other providers set IMAP_HOST; login defaults to the SMTP credentials.
# IMAP_HOST=
# IMAP_USERNAME=
# IMAP_PASSWORD=

# --- Public endpoints ---
PUBLIC_BASE_URL=https://jobhunt-outreach.vercel.app
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
# Protects /cron/tick (the auto emailer trigger)
CRON_SECRET=change-me-too
# Protects the dashboard and API
DASHBOARD_PASSWORD=

# --- Storage: Postgres when hosted (data survives redeploys), SQLite locally ---
DATABASE_URL=
JOBHUNT_DB=data/jobhunt.db
