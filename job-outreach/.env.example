# Copy to .env and fill in. Never commit the real file.

# --- LLM (any OpenAI-compatible chat completions endpoint) ---
# Leave LLM_API_KEY empty to use the offline deterministic tailor.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Contact enrichment (at least one is needed for `enrich`) ---
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- SMTP for a DEDICATED outreach domain (not your primary domain) ---
SMTP_HOST=smtp.example-outreach.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SENDER_NAME=Jane Doe
SENDER_EMAIL=jane@janedoe-careers.com
# DKIM selector your provider publishes at <selector>._domainkey.<domain>
DKIM_SELECTOR=google
# Postal address shown in the email footer (CAN-SPAM style)
SENDER_POSTAL_ADDRESS=

# --- Unsubscribe endpoint (the web app must be publicly reachable here) ---
PUBLIC_BASE_URL=https://jobhunt.example.com
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string

# --- Storage ---
JOBHUNT_DB=data/jobhunt.db
JOBHUNT_OUTPUT_DIR=data/output
