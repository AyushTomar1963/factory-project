# Production (Render): paste Internal Database URL from Render Postgres dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev (optional if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factory_qa
DB_USER=factory
DB_PASSWORD=change-me

# Auth — never use the fallback in production
JWT_SECRET_KEY=local-dev-secret-change-in-production

# Optional: Google Gemini for AI defect reports
GEMINI_API_KEY=

# Optional: restrict CORS (comma-separated). Defaults to * if unset.
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:5173,http://localhost:5174

# ── Test login accounts (run: python seed_test_data.py) ─────────────────────
# admin  / admin123   → Admin dashboard
# worker / worker123  → Worker inspection page
# Test part numbers: PN-1001, PN-2002
