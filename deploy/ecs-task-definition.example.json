{
  "_comment": "Example Fargate task for factory-qa-app backend. Register with: aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-definition.example.json",
  "family": "factory-qa-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/factoryQaTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/factory-qa-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "api-http",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8000" },
        { "name": "DB_HOST", "value": "YOUR_RDS_ENDPOINT" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "factory_qa" }
      ],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:factory-qa/db:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:factory-qa/db:password::"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:factory-qa/app:jwt_secret_key::"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:factory-qa/app:gemini_api_key::"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ping')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/factory-qa-backend",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api",
          "mode": "non-blocking"
        }
      }
    }
  ]
}
