# Copy to repo root .env for production deploy scripts / GitHub Actions secrets reference

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=106062678307

# ECR + ECS (from CloudFormation outputs after deploy/stack.yaml)
ECR_REPOSITORY=factory-qa-backend
ECS_CLUSTER=factory-qa
ECS_SERVICE=factory-qa-api

# Frontend S3 + CloudFront (from stack outputs)
S3_FRONTEND_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
VITE_API_URL=https://YOUR-ALB-DNS-NAME.us-east-1.elb.amazonaws.com

# Database (RDS PostgreSQL — create in RDS console, then paste endpoint)
DB_HOST=your-db.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=factory_qa
DB_USER=factory
DB_PASSWORD=

JWT_SECRET_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=https://YOUR-CLOUDFRONT-DOMAIN.cloudfront.net
